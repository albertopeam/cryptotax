# Fill in the key for the provider you have. If both are set, CryptoCompare is used.

# CryptoCompare — free, no historical data age restriction
# Registration: https://www.cryptocompare.com/cryptopian/api-keys
CRYPTOCOMPARE_API_KEY=

# CoinGecko — requires a paid plan for data older than 365 days
# Registration: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
